# Local configuration for the openshift scripts (make build/push/pull/tag/deploy).
# Copy to openshift/.env - the copy is gitignored (*.env) and loaded automatically by
# scripts/acr-common.sh and scripts/deploy.sh.
#
# ACR credentials used INSTEAD of 'az login'. Required on machines where Conditional Access
# blocks az (it demands a registered device, which a passkey-only account on Ubuntu cannot
# satisfy). Any credential with push access to the registry works:
#   - an ACR token (Azure portal > container registry > Repository permissions > Tokens), or
#   - the registry admin credential, or
#   - a service principal with the AcrPush role.
ACR_USERNAME=
ACR_PASSWORD=

# Optional overrides (defaults shown):
# ACR_REGISTRY=bcgov-c4awhwfpcremdbga.azurecr.io
# ACR_NAME=bcgov

# Optional Elasticsearch migration deployment overrides. Defaults depend on e=:
# dev: indexing-service / elastic / basic
# test, prod: indexing-service-cloud / elastic-cloud / apikey
# ELASTIC_MIGRATION_CONFIGMAP=indexing-service
# ELASTIC_MIGRATION_SECRET=elastic
# ELASTIC_MIGRATION_AUTH=basic

# Migration Job execution budget in seconds (elastic: 86400; db: 1800).
# MIGRATION_ACTIVE_DEADLINE_SECONDS=86400
# Image/container startup wait, independent of execution budget (default 900 seconds).
# MIGRATION_STARTUP_TIMEOUT_SECONDS=900
# Explicit schema baseline ONLY if the target has no migration history.
# ELASTIC_MIGRATION_BASELINE=1.0.10
# Native reindex documents/second (-1 is unlimited).
# ELASTIC_MIGRATION_REQUESTS_PER_SECOND=-1
# Pass ELASTIC_MIGRATION_WRITERS_PAUSED=true for each maintenance-window invocation.
# Do not persist that acknowledgement here: it is valid only while writers are actually paused.
