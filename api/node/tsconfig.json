{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "typeRoots": [
      "src/@types",
      "node_modules/@types"
    ],
    "outDir": "./build/dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "build"
    ],
    "fallbackPolling": "dynamicPriority"
  }
}
