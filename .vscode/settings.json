{
  "git.ignoreLimitWarning": true,
  "yaml.schemas": {
    "kubernetes": "kubernetes.yml",
    "http://json.schemastore.org/appveyor": "appveyor.yml",
    "https://json.schemastore.org/github-workflow": "/.github/workflows/**/*.yml",
    "https://raw.githubusercontent.com/garethr/openshift-json-schema/master/v4.1.0/_definitions.json": "./openshift/**/*.yaml"
  },
  "yaml.schemaStore.enable": false,
  "cSpell.words": [
    "CBRA",
    "CHES",
    "datalabels",
    "formik",
    "healthcheck",
    "Idir",
    "insertable",
    "Keycloak",
    "kowl",
    "Kustomization",
    "kustomize",
    "notnull",
    "opennlp",
    "Renci",
    "Swashbuckle",
    "Unpublish"
  ],
  "java.configuration.updateBuildConfiguration": "interactive",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticHighlighting.enabled": false,
  "editor.suggestSelection": "first",
  // Import order is owned by Prettier (@ianvs/prettier-plugin-sort-imports, app/.prettierrc.json).
  // VS Code's TypeScript "Organize Imports" sorts differently and would fight it on every save,
  // so it is disabled here; format on save sorts, and Oxlint's fixes run explicitly.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.sortImports": "never",
    "source.fixAll.oxc": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.sortImports": "never",
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.sortImports": "never",
      "source.fixAll.oxc": "explicit"
    }
  },
  "editor.quickSuggestionsDelay": 500,
  // Oxlint (oxc.oxc-vscode) lints app/ with app/.oxlintrc.json; Prettier resolves from app/node_modules.
  "oxc.enable": true,
  "editor.tabSize": 2,
  "editor.mouseWheelZoom": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": false,
  "editor.detectIndentation": false,
  "editor.accessibilitySupport": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "omnisharp.enableMsBuildLoadProjectsOnDemand": true,
  "dotnet.server.useOmnisharp": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false
  },
  "dotnet.defaultSolution": "./TNO.sln",
  "dotnet.formatting.organizeImportsOnFormat": true,
}
