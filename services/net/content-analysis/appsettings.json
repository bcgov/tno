{
  "BaseUrl": "/",
  "Logging": {
    "Console": {
      "DisableColors": true
    },
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "TNO": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System.Net.Http": "Warning",
        "TNO": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} level={CustomLevel}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Service": {
    "MaxFailureLimit": 5,
    "ApiUrl": "http://api:8080",
    "TimeZone": "Pacific Standard Time",
    "SendEmailOnFailure": true,
    "Topics": "analysis",
    "BackfillTopic": "analysis-backfill",
    "RetryTopic": "analysis-retry",
    "DeadLetterTopic": "analysis-dlq",
    "Processes": "Metadata,Summary,Quotes,Tags,Contributor,Topics",
    "Reasons": "Lifecycle,Reanalysis,Backfill,Replay",
    "QuietPeriodSeconds": 120,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 30,
    "MaxRetryDelaySeconds": 3600,
    "SettingsRefreshSeconds": 60,
    "WorkOrderRefreshSeconds": 30,
    "BackfillShare": 0.2,
    "LLMRequestTimeoutSeconds": 300,
    "LLMRequestAttempts": 3,
    "SafetyMarginPercent": 10,
    "OverlapTokens": 150,
    "MinTextCharacters": 40
  },
  "CHES": {
    "AuthUrl": "https://loginproxy.gov.bc.ca/auth/realms/comsvcauth/protocol/openid-connect/token",
    "HostUri": "https://ches.api.gov.bc.ca/api/v1",
    "From": "Media Monitoring Insights <mmi@gov.bc.ca>",
    "EmailEnabled": true,
    "EmailAuthorized": false
  },
  "Auth": {
    "Keycloak": {
      "Authority": "https://loginproxy.gov.bc.ca/auth",
      "Audience": "mmi-service-account",
      "Secret": "{DO NOT STORE SECRET HERE}"
    },
    "OIDC": {
      "Token": "/realms/mmi/protocol/openid-connect/token"
    }
  },
  "Serialization": {
    "Json": {
      "PropertyNamingPolicy": "CamelCase",
      "PropertyNameCaseInsensitive": true,
      "DefaultIgnoreCondition": "WhenWritingNull",
      "WriteIndented": true
    }
  },
  "Kafka": {
    "Admin": {
      "ClientId": "ContentAnalysis",
      "BootstrapServers": "kafka-broker-0.kafka-headless:9092,kafka-broker-1.kafka-headless:9092,kafka-broker-2.kafka-headless:9092"
    },
    "Consumer": {
      "GroupId": "ContentAnalysis",
      "BootstrapServers": "kafka-broker-0.kafka-headless:9092,kafka-broker-1.kafka-headless:9092,kafka-broker-2.kafka-headless:9092",
      "AutoOffsetReset": "Earliest",
      "MaxInFlight": 5,
      "EnableAutoCommit": false,
      "MaxThreads": 1
    }
  }
}
