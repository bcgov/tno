# Environment
ENV=test
APP_NAME=qa
CI=false
HEADLESS=false
LOCAL_ONLY=true
TEST_TIMEOUT=300000
ACTION_TIMEOUT=30000

# URLs
EDITOR_URL=http://localhost:40080/
SUBSCRIBER_URL=http://localhost:40081/
API_BASE_URL=http://localhost:40080/api

# Local Docker users use the Local login button; shared environments use Other.
# Editor MMI user (local seed: editor / password)
APP_USERNAME=
APP_PASSWORD=

# Subscriber "Other" MMI user
SUB_USERNAME=
SUB_PASSWORD=

# Second subscriber "Other" MMI user
SUB_USERNAME1=
SUB_PASSWORD1=

# MAIL_TO is used by report preview email tests. Leave blank to skip email delivery.
MAIL_TO=

# Optional Email settings
# MAIL_USER and MAIL_PASSWORD are only required when sending Playwright/Allure reports by email.
MAIL_USER=
MAIL_PASSWORD=
