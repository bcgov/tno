# Local configuration for the openshift scripts (make build/push/pull/tag/deploy).
# Copy to openshift/.env - the copy is gitignored (*.env) and loaded automatically by
# scripts/acr-common.sh and scripts/deploy.sh.
#
# ACR credentials used INSTEAD of 'az login'. Required on machines where Conditional Access
# blocks az (it demands a registered device, which a passkey-only account on Ubuntu cannot
# satisfy). Any credential with push access to the registry works:
#   - an ACR token (Azure portal > container registry > Repository permissions > Tokens), or
#   - the registry admin credential, or
#   - a service principal with the AcrPush role.
ACR_USERNAME=
ACR_PASSWORD=

# Optional overrides (defaults shown):
# ACR_REGISTRY=bcgov-c4awhwfpcremdbga.azurecr.io
# ACR_NAME=bcgov
